# Flask Server Configuration
APP_ENV=development
FLASK_ENV=development
PORT=5000
SECRET_KEY=replace_with_a_random_secret_before_deployment
JWT_SECRET_KEY=replace_with_a_different_random_secret_before_deployment
JWT_ACCESS_TOKEN_EXPIRES_DAYS=7
ALLOW_IN_MEMORY_DB=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENROUTER_TIMEOUT_SECONDS=45
CODE_SANDBOX_IMAGE=python:3.12.8-alpine3.21@sha256:ba13ef990f6e5d13014e9e8d04c02a8fdb0fe53d6dccf6e19147f316e6cc3a84
CODE_TIMEOUT_SECONDS=5

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/microlearn_ai

# OpenRouter AI Gateway (Kept backend-only for security)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODEL=
